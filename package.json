{
  "name": "civicconnect-workspace",
  "version": "1.0.0",
  "description": "CivicConnect: Civic Health and Emergency Assistance Platform with Geospatial Facility Discovery",
  "scripts": {
    "backend:install": "cd backend && npm install",
    "frontend:install": "cd frontend && npm install",
    "backend:dev": "cd backend && npm run dev",
