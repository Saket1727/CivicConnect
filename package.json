    "db:seed": "cd backend && node prisma/seed.js"
  },
  "keywords": [
    "healthcare",
    "geospatial",
    "hospital-management",
    "emergency-assistance",
    "leaflet",
    "openstreetmap",
    "mysql8",
    "prisma",
    "react",
    "btech-major-project"
  ],
